<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F6F8">

    <!-- 顶部栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OldSend" android:textSize="18sp" android:textStyle="bold" android:textColor="#1C1B1F"/>
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#666666" android:singleLine="true" android:ellipsize="end" android:text="已停止"/>
        </LinearLayout>
        <Button android:id="@+id/toggle" android:layout_width="wrap_content" android:layout_height="34dp" android:text="启动" android:textSize="12sp" android:background="@drawable/btn_md3_primary" android:textColor="#FFFFFF" android:minHeight="0dp" android:minWidth="52dp" android:paddingLeft="10dp" android:paddingRight="10dp"/>
        <Button android:id="@+id/btn_log" android:layout_width="wrap_content" android:layout_height="34dp" android:text="日志" android:textSize="12sp" android:background="@drawable/btn_md3_secondary" android:textColor="#1B5E20" android:layout_marginLeft="6dp" android:minHeight="0dp" android:minWidth="44dp" android:paddingLeft="10dp" android:paddingRight="10dp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <!-- 发送页面 -->
        <ScrollView android:id="@+id/page_send" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="visible" android:scrollbars="none">
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                
                <TextView android:id="@+id/tv_select_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择内容" android:textSize="13sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="6dp"/>
                
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="3">
                    <LinearLayout android:id="@+id/card_file" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center" android:layout_marginRight="6dp">
                        <TextView android:id="@+id/tv_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_circle" android:gravity="center" android:text="文" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文件" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="#333"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/card_media" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center" android:layout_marginRight="6dp">
                        <TextView android:id="@+id/tv_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_circle" android:gravity="center" android:text="图" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="媒体" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="#333"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/card_folder" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center">
                        <TextView android:id="@+id/tv_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_circle" android:gravity="center" android:text="夹" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文件夹" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="#333"/>
                    </LinearLayout>
                </LinearLayout>
                
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="3" android:layout_marginTop="6dp">
                    <LinearLayout android:id="@+id/card_app" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center" android:layout_marginRight="6dp">
                        <TextView android:id="@+id/tv_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_circle" android:gravity="center" android:text="应" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="应用" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="#333"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/card_text" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center" android:layout_marginRight="6dp">
                        <TextView android:id="@+id/tv_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_circle" android:gravity="center" android:text="字" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文本" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="#333"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/card_clipboard" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center">
                        <TextView android:id="@+id/tv_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_circle" android:gravity="center" android:text="贴" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剪贴板" android:textSize="12sp" android:layout_marginTop="4dp" android:textColor="#333"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:layout_marginBottom="6dp">
                    <TextView android:id="@+id/tv_nearby_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="附近的设备" android:textSize="13sp" android:textStyle="bold" android:textColor="#1C1B1F"/>
                    <Button android:id="@+id/btn_manual_ip" android:layout_width="wrap_content" android:layout_height="30dp" android:text="加IP" android:textSize="11sp" android:background="@drawable/btn_md3_secondary" android:textColor="#1B5E20" android:minHeight="0dp" android:minWidth="44dp" android:layout_marginRight="6dp"/>
                    <Button android:id="@+id/btn_cross_net" android:layout_width="wrap_content" android:layout_height="30dp" android:text="跨网" android:textSize="11sp" android:background="@drawable/btn_md3_secondary" android:textColor="#1B5E20" android:minHeight="0dp" android:minWidth="44dp" android:layout_marginRight="6dp"/>
                    <Button android:id="@+id/scan" android:layout_width="wrap_content" android:layout_height="30dp" android:text="扫描" android:textSize="11sp" android:background="@drawable/btn_md3_secondary" android:textColor="#1B5E20" android:minHeight="0dp" android:minWidth="52dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/layout_selected_files" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:padding="12dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择" android:textSize="14sp" android:textColor="#1C1B1F" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_selected_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#666" android:layout_marginTop="4dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="8dp">
                        <Button android:id="@+id/btn_edit_files" android:layout_width="wrap_content" android:layout_height="32dp" android:text="编辑" android:textSize="12sp" android:textColor="#49454F" android:background="@android:color/transparent" android:minHeight="0dp" android:minWidth="48dp"/>
                        <Button android:id="@+id/btn_add_files_more" android:layout_width="wrap_content" android:layout_height="32dp" android:text="+ Add" android:textSize="12sp" android:textColor="#FFFFFF" android:background="@drawable/btn_md3_primary" android:minHeight="0dp" android:minWidth="60dp" android:layout_marginLeft="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:layout_marginTop="2dp" android:minHeight="180dp">
                    <ListView android:id="@+id/devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@null" android:dividerHeight="0dp"/>
                    <TextView android:id="@+id/empty_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="暂无设备" android:textColor="#999999" android:textSize="13sp" android:visibility="gone"/>
                </FrameLayout>
                
                <View android:layout_width="match_parent" android:layout_height="20dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- 接收页面 -->
        <ScrollView android:id="@+id/page_receive" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/tv_receive_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="接收记录" android:textSize="13sp" android:textStyle="bold" android:textColor="#1C1B1F" android:layout_marginBottom="6dp"/>
                <ListView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:divider="@null" android:dividerHeight="4dp"/>
                <View android:layout_width="match_parent" android:layout_height="20dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- 设置页面 -->
        <ScrollView android:id="@+id/page_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                
                <TextView android:id="@+id/tv_settings_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置" android:textSize="28sp" android:textStyle="bold" android:textColor="#1C1B1F" android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="20dp"/>
                <TextView android:id="@+id/tv_set_rx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="通用" android:textSize="14sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="8dp" android:layout_marginLeft="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/tv_dark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="深色模式" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_dark_mode" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <!-- 自动接收白名单 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_auto_whitelist" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Auto save favorites" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_auto_whitelist" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_auto_save" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="自动保存" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_auto_save" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_save_album" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="保存到相册" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_save_album" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_save_history" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="保存到历史记录" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_save_history" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_use_pin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="启用 PIN 密码" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_pin" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_pin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前 PIN: 未启用" android:textSize="12sp" android:textColor="#388E3C" android:padding="10dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/row_pin_code" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_pin_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="修改 PIN 码" android:textSize="13sp" android:textColor="#333"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/bg_md3_dropdown" android:paddingLeft="12dp" android:paddingRight="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tv_pin_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0000" android:textSize="13sp" android:textColor="#1B5E20"/>
                </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/tv_net" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="网络与自动化" android:textSize="13sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:id="@+id/tv_https_title" android:text="开启 HTTPS 加密" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_https" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_web" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="启用网页传输" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_web" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_boot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="开机自动启动" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_boot" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_notif" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="通过通知栏接收" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_receive_notif" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/row_port" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_port_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="端口" android:textSize="13sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tv_port_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="53317" android:textSize="13sp" android:textColor="#888"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/row_timeout" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_timeout_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="搜索设备超时" android:textSize="13sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tv_timeout_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500" android:textSize="13sp" android:textColor="#888"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_other" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="其他" android:textSize="13sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
                
                <LinearLayout android:id="@+id/row_language" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_lang_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="语言 (Language)" android:textSize="15sp" android:textColor="#333"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/bg_md3_dropdown" android:paddingLeft="12dp" android:paddingRight="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tv_lang_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="跟随系统" android:textSize="13sp" android:textColor="#1B5E20"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" ▾" android:textSize="12sp" android:textColor="#1B5E20" android:layout_marginLeft="4dp"/>
            </LinearLayout>
        </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_anim_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="界面切换动画" android:textSize="13sp" android:textColor="#333"/>
                    <org.oldsend.ui.Md3Switch android:id="@+id/cb_anim" android:layout_width="44dp" android:layout_height="26dp"/>
                </LinearLayout>

                <!-- 拦截危险后缀 -->
                <LinearLayout android:id="@+id/row_filter_ext" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_filter_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="拦截危险后缀" android:textSize="13sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tv_filter_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="exe,bat..." android:textSize="13sp" android:textColor="#888"/>
                </LinearLayout>
                
                <LinearLayout android:id="@+id/row_set_name" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_set_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="修改设备名称" android:textSize="13sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tv_setting_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="#888"/>
                </LinearLayout>
                
                <LinearLayout android:id="@+id/row_backup" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_backup" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="备份 / 恢复设置" android:textSize="13sp" android:textColor="#333"/>
                </LinearLayout>

                <!-- 名单管理中心 -->
                <LinearLayout android:id="@+id/row_manage_acl" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_manage_acl_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="管理白/黑名单" android:textSize="13sp" android:textColor="#333"/>
                    <TextView android:id="@+id/tv_manage_acl_arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="管理 >" android:textSize="13sp" android:textColor="#888"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/row_about" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/bg_md3_card" android:tag="card" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tv_about" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="关于 OldSend" android:textSize="13sp" android:textColor="#333"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部导航 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="#FFFFFF" android:tag="card" android:padding="8dp" android:gravity="center">
        <LinearLayout android:id="@+id/tab_receive" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tab_receive_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📡" android:textSize="20sp"/>
            <TextView android:id="@+id/tab_receive_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="接收" android:textColor="#666666" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <View android:layout_width="8dp" android:layout_height="match_parent"/>
        <LinearLayout android:id="@+id/tab_send" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/bg_tab_pill" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tab_send_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➤" android:textSize="20sp" android:textColor="#1B5E20"/>
            <TextView android:id="@+id/tab_send_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="发送" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <View android:layout_width="8dp" android:layout_height="match_parent"/>
        <LinearLayout android:id="@+id/tab_settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tab_settings_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" android:textSize="20sp"/>
            <TextView android:id="@+id/tab_settings_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" android:textColor="#666666" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>