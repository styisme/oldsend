<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#666666"
            android:text="已停止"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <Button android:id="@+id/toggle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@drawable/btn_blue" android:textColor="#FFFFFF" android:textSize="13sp" android:text="启动"/>
            <Button android:id="@+id/scan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/btn_grey" android:textColor="#333333" android:textSize="13sp" android:text="扫描"/>
            <Button android:id="@+id/manual" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/btn_grey" android:textColor="#333333" android:textSize="13sp" android:text="添加IP"/>
            <Button android:id="@+id/set_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/btn_grey" android:textColor="#333333" android:textSize="13sp" android:text="改名"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:padding="10dp">

        <Button android:id="@+id/pick_file" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/btn_blue" android:textColor="#FFFFFF" android:textSize="12sp" android:text="选文件"/>
        <Button android:id="@+id/send_text" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/btn_blue" android:textColor="#FFFFFF" android:textSize="12sp" android:text="发文本"/>
        <TextView android:id="@+id/selected_file" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#666666" android:paddingLeft="10dp" android:singleLine="true" android:ellipsize="middle" android:text="未选择(可多选)"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="#333333" android:paddingTop="10dp" android:paddingBottom="6dp" android:text="设备列表 (点击发送)"/>

    <ListView android:id="@+id/devices" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:background="@drawable/bg_card"/>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="6dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="#333333" android:text="运行日志"/>
        <Button android:id="@+id/clear_log" android:layout_width="wrap_content" android:layout_height="30dp" android:textSize="11sp" android:background="@drawable/btn_grey" android:textColor="#333333" android:text="清空"/>
    </LinearLayout>

    <ScrollView android:id="@+id/log_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="8dp">
        <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#555555" android:typeface="monospace"/>
    </ScrollView>
</LinearLayout>
