<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:id="@+id/layout_confirm" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="80sp" android:paddingBottom="20dp"/>
        <TextView android:id="@+id/tv_sender_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HM_Watch_A" android:textColor="#333333" android:textSize="28sp" />
        <TextView android:id="@+id/tv_sender_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android 8.1.0" android:textColor="#FFFFFF" android:background="@drawable/btn_md3_primary" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="12dp" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="想要发送给你 1 个文件" android:textColor="#666666" android:textSize="16sp" android:layout_marginTop="40dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="40dp">
            <Button android:id="@+id/btn_reject" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="拒绝" android:textColor="#B3261E" android:background="@drawable/btn_md3_secondary" android:layout_marginRight="8dp"/>
            <Button android:id="@+id/btn_accept" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="接受" android:textColor="#FFFFFF" android:background="@drawable/btn_md3_primary" android:layout_marginLeft="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/layout_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正在发送文件" android:textSize="22sp" android:textColor="#333" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tv_save_dir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="保存目录: /storage/emulated/0/Download" android:textSize="12sp" android:textColor="#888" android:visibility="gone" android:layout_marginBottom="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_md3_card" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📄" android:textSize="32sp" android:background="#FFE0E0" android:padding="8dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="12dp">
                <TextView android:id="@+id/tv_file_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="测试.wav (39.0 MB)" android:textSize="15sp" android:textColor="#333" />
                <ProgressBar android:id="@+id/pb_file" style="?android:attr/progressBarStyleHorizontal"
        android:progressTint="#388E3C"
        android:progressBackgroundTint="#C8E6C9" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_md3_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tv_total_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="总进度 (1:04)" android:textSize="18sp" android:textColor="#333" />
            <ProgressBar android:id="@+id/pb_total" style="?android:attr/progressBarStyleHorizontal"
        android:progressTint="#388E3C"
        android:progressBackgroundTint="#C8E6C9" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/tv_speed_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="文件: 0 / 1\n大小: 3.7 MB / 39.0 MB\n速度: 730.5 KB/s" android:textSize="13sp" android:textColor="#666" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="16dp">
                <Button android:id="@+id/btn_cancel" android:layout_width="wrap_content" android:layout_height="40dp" android:text="取消" android:textColor="#B3261E" android:background="@drawable/btn_md3_secondary" android:minHeight="0dp"/>
                <Button android:id="@+id/btn_done" android:layout_width="wrap_content" android:layout_height="40dp" android:text="完成" android:textColor="#FFFFFF" android:background="@drawable/btn_md3_primary" android:layout_marginLeft="8dp" android:visibility="gone" android:minHeight="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
