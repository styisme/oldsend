<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_transfer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <!-- ================= 接收确认界面 ================= -->
    <LinearLayout android:id="@+id/layout_confirm" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:orientation="vertical" 
        android:visibility="gone">
        
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📱" android:textSize="40sp" android:paddingBottom="8dp"/>

                <TextView android:id="@+id/tv_sender_name" 
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HM_Watch_A" android:textColor="#1C1B1F" 
                    android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>

                <TextView android:id="@+id/tv_sender_type" 
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Android" android:textColor="#FFFFFF" 
                    android:background="@drawable/bg_device_tag" 
                    android:paddingLeft="8dp" android:paddingRight="8dp" 
                    android:paddingTop="2dp" android:paddingBottom="2dp" 
                    android:layout_marginTop="6dp" android:textSize="10sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="想要发送给你文件" android:textColor="#49454F" 
                    android:textSize="14sp" android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <!-- 按钮固定在底部 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:padding="8dp" android:background="#F4F6F8">
            
            <Button android:id="@+id/btn_reject" 
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:text="✕ 拒绝" android:textColor="#FFFFFF" 
                android:textSize="12sp" android:textStyle="bold"
                android:background="@drawable/btn_reject" android:layout_marginRight="6dp"/>
                
            <Button android:id="@+id/btn_accept" 
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:text="✔ 接受" android:textColor="#FFFFFF" 
                android:textSize="12sp" android:textStyle="bold"
                android:background="@drawable/btn_accept" android:layout_marginLeft="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 进度界面 ================= -->
    <LinearLayout android:id="@+id/layout_progress" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:orientation="vertical" 
        android:visibility="gone">

        <!-- 上部滚动区域 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                
                <TextView android:id="@+id/tv_title" 
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="正在发送文件" android:textSize="16sp" android:textColor="#1C1B1F" />

                <TextView android:id="@+id/tv_save_dir" 
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="保存目录: /Download" 
                    android:textSize="10sp" android:textColor="#888" 
                    android:visibility="gone" android:layout_marginTop="2dp" android:layout_marginBottom="6dp"/>

                <!-- 当前文件卡片 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
                    android:background="@drawable/bg_md3_card" android:tag="card" 
                    android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
                    
                    <TextView android:id="@+id/tv_file_icon" 
                        android:layout_width="32dp" android:layout_height="32dp" 
                        android:text="📄" android:textSize="16sp" android:gravity="center"
                        android:background="#C8E6C9" />
                        
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" 
                        android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="8dp">
                        
                        <TextView android:id="@+id/tv_file_name" 
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="测试.wav" android:textSize="12sp" android:textColor="#1C1B1F" 
                            android:singleLine="true" android:ellipsize="middle"/>
                            
                        <TextView android:id="@+id/tv_file_status" 
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="#388E3C" android:visibility="gone" android:layout_marginTop="2dp"/>
                            
                        <ProgressBar android:id="@+id/pb_file" 
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progressTint="#388E3C" android:progressBackgroundTint="#C8E6C9" 
                            android:layout_width="match_parent" android:layout_height="wrap_content" 
                            android:max="100" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 底部总进度与操作区，固定 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:background="@drawable/bg_md3_card" android:tag="card" 
            android:orientation="vertical" android:padding="10dp">
            
            <TextView android:id="@+id/tv_total_title" 
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="总进度" android:textSize="14sp" android:textColor="#1C1B1F" />
                
            <ProgressBar android:id="@+id/pb_total" 
                style="?android:attr/progressBarStyleHorizontal"
                android:progressTint="#388E3C" android:progressBackgroundTint="#C8E6C9" 
                android:layout_width="match_parent" android:layout_height="wrap_content" 
                android:max="100" android:layout_marginTop="4dp"/>
                
            <TextView android:id="@+id/tv_speed_info" 
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="大小: 0 / 0
速度: 0 KB/s" 
                android:textSize="10sp" android:textColor="#666" 
                android:layout_marginTop="6dp" android:lineSpacingExtra="2dp"/>
                
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
                android:orientation="horizontal" android:gravity="end" android:layout_marginTop="6dp">
                
                <Button android:id="@+id/btn_cancel" 
                    android:layout_width="wrap_content" android:layout_height="32dp" 
                    android:text="✕ 取消" android:textColor="#B3261E" 
                    android:background="@drawable/btn_cancel_transfer" android:minHeight="0dp"
                    android:textSize="10sp" android:paddingLeft="10dp" android:paddingRight="10dp"/>
                    
                <Button android:id="@+id/btn_done" 
                    android:layout_width="wrap_content" android:layout_height="32dp" 
                    android:text="✔ 完成" android:textColor="#FFFFFF" 
                    android:background="@drawable/btn_accept" android:layout_marginLeft="8dp" 
                    android:visibility="gone" android:minHeight="0dp"
                    android:textSize="10sp" android:paddingLeft="10dp" android:paddingRight="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>