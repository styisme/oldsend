<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_transfer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout android:id="@+id/layout_confirm" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:gravity="center" 
        android:orientation="vertical" 
        android:padding="24dp"
        android:visibility="gone">
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📱" android:textSize="80sp" android:paddingBottom="20dp"/>

        <TextView android:id="@+id/tv_sender_name" 
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="HM_Watch_A" android:textColor="#1C1B1F" 
            android:textSize="32sp" android:textStyle="bold" />

        <TextView android:id="@+id/tv_sender_type" 
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Android 8.1.0" android:textColor="#FFFFFF" 
            android:background="@drawable/bg_device_tag" 
            android:paddingLeft="12dp" android:paddingRight="12dp" 
            android:paddingTop="4dp" android:paddingBottom="4dp" 
            android:layout_marginTop="12dp" android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="想要发送给你文件" android:textColor="#49454F" 
            android:textSize="18sp" android:layout_marginTop="40dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="40dp">
            
            <Button android:id="@+id/btn_reject" 
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:text="✕ 拒绝" android:textColor="#FFFFFF" 
                android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/btn_reject" android:layout_marginRight="12dp"/>
                
            <Button android:id="@+id/btn_accept" 
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:text="✔ 接受" android:textColor="#FFFFFF" 
                android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/btn_accept" android:layout_marginLeft="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/layout_progress" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:orientation="vertical" 
        android:visibility="gone"
        android:padding="20dp">
        
        <TextView android:id="@+id/tv_title" 
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="正在发送文件" android:textSize="24sp" android:textColor="#1C1B1F" 
            android:layout_marginTop="20dp"/>

        <TextView android:id="@+id/tv_save_dir" 
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="保存目录: /storage/emulated/0/Download" 
            android:textSize="14sp" android:textColor="#888" 
            android:visibility="gone" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:background="@drawable/bg_md3_card" android:tag="card" 
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            
            <TextView android:id="@+id/tv_file_icon" 
                android:layout_width="48dp" android:layout_height="48dp" 
                android:text="📄" android:textSize="24sp" android:gravity="center"
                android:background="#C8E6C9" />
                
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" 
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="16dp">
                
                <TextView android:id="@+id/tv_file_name" 
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="测试.wav (39.0 MB)" android:textSize="16sp" android:textColor="#1C1B1F" 
                    android:singleLine="true" android:ellipsize="middle"/>
                    
                <TextView android:id="@+id/tv_file_status" 
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#388E3C" android:visibility="gone" android:layout_marginTop="4dp"/>
                    
                <ProgressBar android:id="@+id/pb_file" 
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progressTint="#388E3C" android:progressBackgroundTint="#C8E6C9" 
                    android:layout_width="match_parent" android:layout_height="wrap_content" 
                    android:max="100" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:background="@drawable/bg_md3_card" android:tag="card" 
            android:orientation="vertical" android:padding="20dp">
            
            <TextView android:id="@+id/tv_total_title" 
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="总进度" android:textSize="20sp" android:textColor="#1C1B1F" />
                
            <ProgressBar android:id="@+id/pb_total" 
                style="?android:attr/progressBarStyleHorizontal"
                android:progressTint="#388E3C" android:progressBackgroundTint="#C8E6C9" 
                android:layout_width="match_parent" android:layout_height="wrap_content" 
                android:max="100" android:layout_marginTop="12dp"/>
                
            <TextView android:id="@+id/tv_speed_info" 
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="文件: 0 / 1\n大小: 0 / 0\n速度: 0 KB/s" 
                android:textSize="14sp" android:textColor="#666" 
                android:layout_marginTop="16dp" android:lineSpacingExtra="6dp"/>
                
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" 
                android:orientation="horizontal" android:gravity="end" android:layout_marginTop="20dp">
                
                <Button android:id="@+id/btn_cancel" 
                    android:layout_width="wrap_content" android:layout_height="48dp" 
                    android:text="✕ 取消" android:textColor="#B3261E" 
                    android:background="@drawable/btn_cancel_transfer" android:minHeight="0dp"
                    android:paddingLeft="20dp" android:paddingRight="20dp"/>
                    
                <Button android:id="@+id/btn_done" 
                    android:layout_width="wrap_content" android:layout_height="48dp" 
                    android:text="✔ 完成" android:textColor="#FFFFFF" 
                    android:background="@drawable/btn_accept" android:layout_marginLeft="12dp" 
                    android:visibility="gone" android:minHeight="0dp"
                    android:paddingLeft="20dp" android:paddingRight="20dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>