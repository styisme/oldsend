<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_md3_card"
    android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置" android:textSize="18sp" android:textStyle="bold" android:textColor="#1C1B1F" android:layout_marginBottom="16dp"/>

    <!-- 修改名称 -->
    <LinearLayout android:id="@+id/set_name_row" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="修改设备名称" android:textSize="14sp" android:textColor="#333333"/>
        <TextView android:id="@+id/tv_current_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#999999"/>
    </LinearLayout>

    <!-- HTTPS 开关 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="开启 HTTPS 加密" android:textSize="14sp" android:textColor="#333333"/>
        <CheckBox android:id="@+id/cb_https" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#388E3C"/>
    </LinearLayout>

    <!-- 动画开关 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="界面切换动画" android:textSize="14sp" android:textColor="#333333"/>
        <CheckBox android:id="@+id/cb_anim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="#388E3C"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

    <!-- 关于 -->
    <LinearLayout android:id="@+id/about_row" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="关于 OldSend" android:textSize="14sp" android:textColor="#388E3C" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
